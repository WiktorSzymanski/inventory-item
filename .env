# Single knob for the whole stack. Auto-loaded by docker compose for EVERY command, so the
# value stays sticky (unlike an inline `REPLICAS=2 docker compose up`, which is forgotten by
# the next `docker compose ps`).
#
# REPLICAS sets BOTH the container count (deploy.replicas on api-es) and API_REPLICAS, which
# drives the saga per-node claim = ceil(total-segments / replicas). They must not diverge:
# too low leaves segments unclaimed, too high over-subscribes them.
#
# Scale with this variable only — do NOT pass `--scale` as well. Mixing --scale with
# deploy.replicas makes Compose remove middle replicas.
REPLICAS=1

# Postgres connection ceiling. ~200 connections per replica on the ES family
# (Hikari 50 + Axon 150). 300 is the historical single-node value and every existing
# benchmark result assumes it; raise it in step with REPLICAS (1000 covers ~4-5 replicas).
PG_MAX_CONNECTIONS=300
