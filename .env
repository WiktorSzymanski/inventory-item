# Single knob for the whole stack. Auto-loaded by docker compose for EVERY command, so the
# value stays sticky (unlike an inline `REPLICAS=2 docker compose up`, which is forgotten by
# the next `docker compose ps`).
#
# REPLICAS sets BOTH the container count (deploy.replicas on api-to) and API_REPLICAS.
#
# Scale with this variable only — do NOT pass `--scale` as well. Mixing --scale with
# deploy.replicas makes Compose remove middle replicas.
#
# WARNING: the infrastructure handles REPLICAS>1 correctly, but the DOMAIN does not yet.
# Spring Modulith's event poller (spring.modulith.events.polling-interval: PT1S here) runs
# on every node against the shared event_publication table, so two replicas may pick up and
# publish the same incomplete row. Keep this at 1 for any run whose numbers you intend to use.
REPLICAS=1

# Postgres connection ceiling. ~50 connections per replica on the TO family (Hikari only).
# 300 is the historical single-node value that every existing benchmark result assumes;
# raise it in step with REPLICAS.
PG_MAX_CONNECTIONS=300
