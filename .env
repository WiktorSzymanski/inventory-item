# Single knob for the whole stack. Auto-loaded by docker compose for EVERY command, so the
# value stays sticky (unlike an inline `REPLICAS=2 docker compose up`, which is forgotten by
# the next `docker compose ps`).
#
# REPLICAS sets BOTH the container count (deploy.replicas on api-to) and API_REPLICAS.
#
# Scale with this variable only — do NOT pass `--scale` as well. Mixing --scale with
# deploy.replicas makes Compose remove middle replicas.
#
# WARNING: REPLICAS>1 is wired up but has NOT been load-tested on this branch.
# Structurally TO looks multi-node tolerant, unlike ES: a lost write race is retried 4x
# (@Retryable on OptimisticLockingFailureException) and then turned into a FAILED order
# via FailOrderCommand, so contention shows up as a higher rejection rate rather than a
# hung backlog. There is no known permanent-stall path.
# Delivery is deduped across nodes: EventPublicationDirectProcessor claims each
# event_publication row with `UPDATE ... WHERE completion_date IS NULL` inside one
# transaction, so exactly one replica delivers it.
# Verify under load before trusting any multi-replica numbers.
REPLICAS=1

# Postgres connection ceiling. ~50 connections per replica on the TO family (Hikari only).
# 300 is the historical single-node value that every existing benchmark result assumes;
# raise it in step with REPLICAS.
PG_MAX_CONNECTIONS=300
