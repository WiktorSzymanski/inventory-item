# Number of api-es replicas. Auto-loaded by docker compose for EVERY command, so the
# replica count stays sticky — starting k6 (or any other service) no longer scales api-es
# down. Change this value and run `docker compose up -d` to rescale.
#
# Drives both deploy.replicas (container count) and API_REPLICAS (saga per-node claim =
# ceil(total-segments / REPLICAS)). Do NOT pass --scale.
REPLICAS=4
