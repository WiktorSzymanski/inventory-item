# Sourced by scripts/run-suite.sh in the subshell that runs this variant, before bench.sh.
#
# Same reason as variants.d/TO-3.env, which this mirrors: TO-3-newT forked from TO-3 and inherits
# its ONE 200-thread order pool. docker-compose pins ORDER_WORKER_THREADS=${ORDER_WORKER_THREADS:-150}
# for every TO branch, so left alone the branch runs 50 execution threads narrower than the TO-3 it
# is paired against — a resourcing difference dressed up as a transaction-shape result.
#
# As on TO-2-newT, this branch holds a connection for a much shorter share of each order than its
# baseline does (the read is one query and the reserveDelayMs sleep happens with no connection
# checked out), so it will lean on the 50-connection Hikari pool less at the same width. That is a
# finding, not a reason to resize either side of the pair.
export ORDER_WORKER_THREADS=200
