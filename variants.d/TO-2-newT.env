# Sourced by scripts/run-suite.sh in the subshell that runs this variant, before bench.sh.
#
# Same reason as variants.d/TO-2.env, which this mirrors: TO-2-newT forked from TO-2 and inherits
# its ONE 200-thread order pool. docker-compose pins ORDER_WORKER_THREADS=${ORDER_WORKER_THREADS:-150}
# for every TO branch, so left alone the branch runs 50 execution threads narrower than the TO-2 it
# is paired against — a resourcing difference dressed up as a transaction-shape result, and nothing
# fails to show for it.
#
# TO-2-newT holds a connection for a much shorter share of each order than TO-2 does (the read is
# one query and the reserveDelayMs sleep happens with no connection checked out), so it will lean on
# the 50-connection Hikari pool less at the same width. That is a finding, not a reason to resize
# either side of the pair.
export ORDER_WORKER_THREADS=200
