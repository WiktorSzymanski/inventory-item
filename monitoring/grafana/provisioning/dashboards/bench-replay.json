{
  "uid": "bench-replay",
  "title": "Bench Replay (archived runs)",
  "description": "Generated by scripts/dashboards/build.py \u2014 do not edit by hand. Rebuilt from bench-results/<run_id>/dump.json by scripts/replay_run.py; NOT the original Prometheus data. All runs are anchored to a common origin so several can be overlaid: the time axis is elapsed time since each run's window_full start, displayed from 2026-01-01T00:00:00.000Z.",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "",
  "schemaVersion": 39,
  "tags": [
    "inventory"
  ],
  "timezone": "browser",
  "time": {
    "from": "2026-01-01T00:00:00.000Z",
    "to": "2026-01-01T02:00:00.000Z"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "links": [],
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "runs",
        "label": "Runs",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-replay"
        },
        "query": {
          "query": "label_values(replay_series, run_id)",
          "refId": "runs-variable"
        },
        "definition": "label_values(replay_series, run_id)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 25,
      "title": "Run summary (dump.json derived + scalars)",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-replay"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "right"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-replay"
          },
          "expr": "last_over_time(replay_summary{run_id=~\"$runs\"}[$__range])",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            }
          }
        },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "key",
            "rowField": "run_id",
            "valueField": "Value"
          }
        }
      ]
    },
    {
      "id": 1,
