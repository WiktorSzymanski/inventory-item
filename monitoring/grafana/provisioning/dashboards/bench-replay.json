        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-replay"
          },
          "expr": "replay_series{run_id=~\"$runs\",metric=\"rate_accepted\"}",
          "legendFormat": "{{run_id}} accepted (202)",
