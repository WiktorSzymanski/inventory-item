      "title": "HTTP",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Request rate by endpoint & method",
      "description": "sum(rate(http_server_requests_seconds_count)) by (uri, method). Replaces the separate per-family throughput panels the three old dashboards each had.",
