          "legendFormat": "cpu",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Throughput — offered vs accepted vs terminal",
      "description": "One axis, all four series in orders/s. Dashed = what was asked of the system (step target, k6 offered); solid = what it did (202 accepts, terminal orders). Accepted tracking below offered means admission is the bottleneck; terminal below accepted means the backlog is growing. Target rate is absent for non-stepped scenarios.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "step target" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#8E8E8E" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.lineInterpolation", "value": "stepAfter" },
              { "id": "custom.lineWidth", "value": 1 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "k6 offered" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#B877D9" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [4, 6] } },
              { "id": "custom.lineWidth", "value": 1 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "accepted (202)" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#3274D9" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "terminal" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF9830" } }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max", "lastNotNull"],
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "replay_rate_accepted{run_id=\"$run\"}",
          "legendFormat": "accepted (202)",
