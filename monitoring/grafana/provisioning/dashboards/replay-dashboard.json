{
  "uid": "bench-replay",
  "title": "Bench Replay (archived runs)",
  "description": "Archived benchmark runs, rebuilt from bench-results/<run_id>/dump.json by scripts/replay_run.py. These are the nine range series dump.py extracted at 5s resolution -- NOT the original Prometheus data, which the harness does not keep. Everything here is a replay_* gauge at the run's original wall-clock timestamps; pick the run with the variable and the matching time range with the picker (scripts/replay_run.py prints a URL carrying both).",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "",
  "schemaVersion": 39,
  "tags": ["bench", "replay"],
  "timezone": "browser",
  "time": {
    "from": "2026-08-05T15:42:08.000Z",
    "to": "2026-08-05T17:02:09.000Z"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "links": [],
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "run",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(replay_inflight, run_id)",
          "refId": "replay-run-variable"
        },
        "definition": "label_values(replay_inflight, run_id)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Accepted rate (mean over range)",
      "description": "Mean of the 202-accept rate across the selected time range. The default range spans load AND drain, so it sits well below the load-window figure in dump.json's derived.achieved_rps_load_window.",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["mean"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "replay_rate_accepted{run_id=\"$run\"}",
          "legendFormat": "accepted",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Peak in-flight",
      "description": "Highest admitted-but-not-terminal backlog reached in range.",
      "type": "stat",
      "gridPos": { "x": 5, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["max"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "replay_inflight{run_id=\"$run\"}",
          "legendFormat": "in-flight",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Worst e2e p95",
      "description": "Maximum of the 1m-window p95 end-to-end order latency.",
      "type": "stat",
      "gridPos": { "x": 10, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
