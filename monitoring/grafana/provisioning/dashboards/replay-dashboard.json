      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "replay_db_size{run_id=\"$run\"}",
          "legendFormat": "db size",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Peak CPU",
      "description": "Maximum process CPU usage across the API in range.",
      "type": "stat",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
